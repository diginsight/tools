{
    "BlobProxy": {
        "AccountUri": "https://samplestmcstitn01.blob.core.windows.net",
        "ContainerName": "learn",
        "NotFoundBlob": "404.html",
        "CacheSizeLimitBytes": 200000000,
        "InvalidateApiKey": ""
    },
    "AzureKeyVault": {
        "Uri": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Diginsight": {
        "Activities": {
            "LogBehavior": "Show",
            "LogLevel": "Debug",
            "RecordSpanDuration": true,
            "MeterName": "Learn.Web",
            "ActivitySources": {
                "Microsoft.AspNetCore": true,
                "System.Net.Http": true,
                "Experimental.*": false,
                "Diginsight.*": true,
                "Learn.Web": true
            },
            "LoggedActivityNames": {
                "System.Net.Http|System.Net.Http.HttpRequestOut": "Hide",
                "Microsoft.AspNetCore.Hosting.HttpRequestIn": "Hide"
            }
        }
    },
    "Observability": {
        "ConsoleEnabled": true,
        "Log4NetEnabled": true,
        "DebugEnabled": false
    },
    "OpenTelemetry": {
        "EnableTraces": true,
        "EnableMetrics": true,
        "AzureMonitorConnectionString": "",
        "ActivitySources": [
            "Microsoft.AspNetCore",
            "Diginsight.*",
            "Learn.Web"
        ],
        "Meters": [
            "Learn.Web"
        ],
        "ExcludedHttpHosts": [
            ".applicationinsights.azure.com",
            ".monitor.azure.com"
        ]
    },
    "AllowedHosts": "*"
}
